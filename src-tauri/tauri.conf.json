{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperCode",
  "version": "0.1.0",
  "identifier": "com.supercode.desktop",
  "build": {
    "devUrl": "http://localhost:8888",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperCode",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/supercode-backend"
    ]
  }
}
