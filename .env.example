# 简单编码智能体的真实 API 配置示例
# 复制本文件为 .env 后，再填入你自己的值

SC_AGENT_API_KEY=your_api_key_here
# 这里只填公共前缀，例如 https://api.openai.com/v1 或 https://openrouter.ai/api/v1
# 不要把 /chat/completions 或 /responses 填进来，后端会按 API 模式自动补后缀
SC_AGENT_BASE_URL=https://api.openai.com/v1
SC_AGENT_API_MODE=chat_completions
SC_AGENT_MODEL=your_model_name_here
SC_AGENT_TIMEOUT=60
SC_AGENT_INCLUDE_THOUGHTS_IN_CONTEXT=false
SC_TINYFISH_API_KEY=your_tinyfish_api_key_here
